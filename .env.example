# =====================================================================
# Modèle de configuration du déploiement — CE FICHIER EST SUIVI PAR GIT
#
# Il ne contient que des valeurs d'exemple. Copier vers .env puis remplir :
#
#   Windows (PowerShell) : Copy-Item .env.example .env
#   macOS / Linux        : cp .env.example .env
#
# .env est ignoré par Git et ne doit jamais être commité ni poussé.
# =====================================================================

# ---------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------
DB_NAME=schoolmanagement
DB_USERNAME=school

# Remplacer par un mot de passe long et aléatoire, propre à cette machine.
# Générer avec : openssl rand -base64 32
DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_ALEATOIRE

# ---------------------------------------------------------------------
# Sécurité — JWT
# ---------------------------------------------------------------------
# Clé de signature HS256, 256 bits minimum. Sans elle, l'application refuse de
# démarrer, et c'est voulu.
# Générer avec : openssl rand -base64 48
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_DE_48_OCTETS

# Durée de vie d'un jeton, en millisecondes (3600000 = 1 heure).
JWT_EXPIRATION_MS=3600000

# ---------------------------------------------------------------------
# Compte ADMIN initial
# ---------------------------------------------------------------------
# Créé au premier démarrage si aucun ADMIN n'existe. À choisir soi-même : cette
# valeur ouvre l'accès complet à l'application, y compris aux encaissements.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=A_DEFINIR_PAR_ADMINISTRATEUR

# ---------------------------------------------------------------------
# Photos des étudiants et enseignants
# ---------------------------------------------------------------------
# Dossier de l'HÔTE qui reçoit les photos. C'est le dossier à copier sur une clé
# USB pour la sauvegarde. Il doit exister avant le premier démarrage.
#   Windows : D:/school-data/uploads   (barres obliques, pas d'antislash)
#   macOS   : ./uploads/images
UPLOAD_HOST_DIR=./uploads/images

# Chemin correspondant DANS le conteneur. À laisser tel quel sauf raison précise.
UPLOAD_DIR=/app/uploads/images

# ---------------------------------------------------------------------
# Réseau
# ---------------------------------------------------------------------
# Port publié sur la machine hôte. Vérifier d'abord que 80 est libre :
#   netstat -ano | findstr :80
# S'il est occupé, mettre 8081 — l'application sera alors sur http://<ip>:8081
HTTP_PORT=80

# Origine publique de l'API. À laisser VIDE : le front et l'API partagent une
# seule origine, donc les URLs de photos sont relatives et survivent à un
# changement d'adresse IP de la machine.
SERVER_BASE_URL=

# Fuseau horaire, utilisé pour l'horodatage des paiements et des séances.
TZ=Europe/Paris
