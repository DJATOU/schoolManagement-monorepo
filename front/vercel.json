{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/school-management-front/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://schoolmanager-api-iwzf.onrender.com/api/$1" },
    { "source": "/personne/(.*)", "destination": "https://schoolmanager-api-iwzf.onrender.com/personne/$1" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
